# === Tienda (@maqserv/web, Next.js) ===
# En LOCAL copia este archivo a .env.local. En PRODUCCIÓN se configuran en
# Vercel → Project Settings → Environment Variables.

# URL de la API NestJS (server-side; NO lleva NEXT_PUBLIC porque el navegador
# nunca llama a la API directo: Next hace de proxy del lado del servidor).
API_URL="https://servmaq-api.onrender.com"


# URL pública del sitio (sitemap.xml, robots.txt, canonical).
SITE_URL="https://tu-tienda.vercel.app"

# Google Tag Manager (contenedor GTM-XXXXXXX). Vacía = analítica apagada: ni
# script ni aviso de cookies. GA4/Ads se configuran DENTRO de GTM, no aquí.
# Es NEXT_PUBLIC_: se incrusta en el build (en cPanel va como variable del
# repo para el workflow de empaquetado, no en las variables del hosting).
NEXT_PUBLIC_GTM_ID=""

# Revalidación on-demand (mismo valor que REVALIDATE_SECRET de la API).
REVALIDATE_SECRET="<cadena aleatoria larga>"

# Firma con la que le pasamos a la API la IP real del visitante (para que su límite de
# peticiones cuente por persona y no por servidor). Mismo valor que en la API.
PROXY_SECRET="<cadena aleatoria larga — mismo valor que en la API>"
