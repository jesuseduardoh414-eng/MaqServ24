{
  "name": "maqserv-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma e-commerce B2B (maquinaria/médico) — migración de scava.website a Next.js + NestJS + Prisma",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @maqserv/db generate",
    "db:pull": "pnpm --filter @maqserv/db pull"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "sharp"
    ],
    "overrides": {
      "multer": "^2.4.0",
      "sharp": "^0.35.4",
      "fast-uri": "^3.1.7",
      "js-yaml@4": "^4.3.2",
      "postcss": "^8.5.23",
      "qs": "^6.16.0",
      "nanoid@3": "^3.3.18",
      "browserslist": "^4.28.7",
      "deepmerge-ts": "^8.0.0",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@5": "^5.0.9",
      "baseline-browser-mapping": "^2.11.0"
    }
  }
}
