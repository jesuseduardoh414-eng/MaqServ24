node_modules/
dist/
.next/
.turbo/
*.log

# Entorno — nunca versionar credenciales (lección del proyecto anterior)
.env
.env.*
!.env.example

# Prisma
packages/db/generated/

# Imágenes de referencia/diseño (scratch local; los assets reales viven en Supabase Storage)
imagenes/

# Subidas locales de dev (en prod las imágenes van a Supabase Storage)
uploads/

# Respaldos del tema antes de aplicar un rebranding (artefacto local, no versionable)
packages/db/respaldos-tema/

# Paquetes listos para subir a cPanel (se regeneran con scripts/empaquetar-cpanel.cjs)
dist-cpanel/

# Archivos del bucket de Supabase bajados con migrate/44 (se suben a MEDIA_DIR en cPanel)
media/

# Datos exportados de una BD (tarifas reales): no van al repo público.
packages/db/sql/*-locales.sql
