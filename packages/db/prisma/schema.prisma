/// Avisos al cliente. Las 244 filas legacy (2021) traen user_id NULL y solo apuntaban
/// a un pedido; la política RLS `notif_own_select` (user_id = app_user_id) las excluye
/// sola, y sin `type` tampoco las lista la API. Ya está en la publicación de Realtime.
model notifications {
  id              Int       @id @default(autoincrement())
  order_id        Int?
  user_id         Int?
  vendor_id       Int?
  product_id      Int?
  conversation_id Int?
  is_read         Boolean   @default(false)
  created_at      DateTime? @db.DateTime(0)
  updated_at      DateTime? @db.DateTime(0)
  body            String? @db.Text
  /// Ruta interna del sitio a la que lleva el aviso (p. ej. /pedido/ABC123)
  link            String?   @db.VarChar(200)
  title           String?   @db.VarChar(160)
  /// quote_answered | order_status | payment_confirmed | question_answered
  type            String?   @db.VarChar(40)

  @@index([user_id, is_read], map: "notifications_user_read_idx")
}

model orders {
  id               Int            @id @default(autoincrement())
  user_id          Int
  cart             Bytes @db.LongBlob
  method           String?        @db.VarChar(255)
  shipping         String?        @db.VarChar(255)
  pickup_location  String?        @db.VarChar(255)
  totalQty         String @db.Text
  /// double precision, no real: un float de 32 bits pierde los centavos arriba
  /// de ~$83,886 y los totales de maquinaria pesada lo cruzan con facilidad.
  pay_amount       Float          @db.Double
  txnid            String?        @db.VarChar(255)
  charge_id        String?        @db.VarChar(255)
  order_number     String         @unique(map: "orders_order_number_key") @db.VarChar(255)
  payment_status   String         @db.VarChar(255)
  customer_email   String?        @db.VarChar(255)
  customer_name    String?        @db.VarChar(255)
  customer_country String? @db.Text
  customer_phone   String?        @db.VarChar(255)
  customer_address String?        @db.VarChar(255)
  customer_city    String?        @db.VarChar(255)
  customer_zip     String?        @db.VarChar(255)
  shipping_name    String?        @db.VarChar(255)
  shipping_country String? @db.Text
  shipping_email   String?        @db.VarChar(255)
  shipping_phone   String?        @db.VarChar(255)
  shipping_address String?        @db.VarChar(255)
  shipping_city    String?        @db.VarChar(255)
  shipping_zip     String?        @db.VarChar(255)
  order_note       String? @db.Text
  coupon_code      String? @db.Text
  coupon_discount  String? @db.Text
  status           orders_status  @default(pending)
  created_at       DateTime?      @db.DateTime(0)
  updated_at       DateTime?      @db.DateTime(0)
  affilate_user    String? @db.Text
  affilate_charge  String? @db.Text
  currency_sign    String?        @db.VarChar(10)
  currency_value   Float?
  shipping_cost    Float?
  tax              Int?
  dp               Boolean?       @default(false)
  branch           String?        @db.VarChar(120)
  carrier          String?        @db.VarChar(60)
  delivered_at     DateTime?      @db.DateTime(0)
  fulfillment      String?        @db.VarChar(20)
  returned_at      DateTime?      @db.DateTime(0)
  scheduled_at     DateTime?      @db.DateTime(0)
  ship_method      String?        @db.VarChar(20)
  ship_notes       String? @db.Text
  ship_unit        String?        @db.VarChar(80)
  shipped_at       DateTime?      @db.DateTime(0)
  tracking         String?        @db.VarChar(80)
  stock_released   Boolean        @default(false)
  /// Clave que manda el cliente en el checkout: si el mismo intento llega dos
  /// veces (proxy que agotó su tiempo, usuario que reintenta tras un error),
  /// el unique lo frena y se devuelve la orden ya creada en vez de duplicar
  /// stock retenido y usos de cupón.
  idempotency_key  String?        @unique(map: "orders_idempotency_key_key") @db.VarChar(64)
  events           order_events[]

  @@index([user_id], map: "orders_user_id_idx")
  @@index([fulfillment], map: "orders_fulfillment_idx")
  @@index([payment_status, created_at], map: "orders_payment_status_created_idx")
}

/// Tabla NUEVA (no viene del Laravel viejo): historial de envío de cada orden.
/// Lo escribe SOLO `FulfillmentService.setState()`; si alguien cambia `fulfillment`
/// por fuera, el historial miente.
model order_events {
  id         Int      @id @default(autoincrement())
  order_id   Int
  /// Admin que hizo el cambio; null = automático (webhook de pago).
  admin_id   Int?
  from_state String?  @db.VarChar(20)
  to_state   String   @db.VarChar(20)
  note       String? @db.Text
  created_at DateTime @default(now()) @db.DateTime(0)
  order      orders   @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id, id])
  @@map("order_events")
}

