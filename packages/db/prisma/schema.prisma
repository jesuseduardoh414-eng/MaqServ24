model categories {
  id       Int     @id @default(autoincrement())
  cat_name String  @db.VarChar(100)
  cat_slug String  @unique(map: "bloodgroups_slug_unique") @db.VarChar(191)
  status   Int     @default(1) @db.SmallInt
  photo    String? @db.Text
  // Una línea bajo el nombre en las tarjetas del sitio ("Arena, grava, base
  // hidráulica y CNC"). Editable desde el panel. Columna agregada 2026-09-21.
  description String? @db.Text
  // Orden en que el cliente presenta las líneas de servicio (1 = primera). El
  // catálogo público y el panel ordenan por esto y luego por nombre; 0 = al
  // final, en orden alfabético. Columna agregada 2026-09-21.
  sort_order  Int     @default(0)

  @@index([id], map: "id")
}

model childcategories {
  id             Int    @id @default(autoincrement())
  subcategory_id Int
  child_name     String @db.Text
  child_slug     String @db.Text
  status         Int    @default(1) @db.SmallInt
}

model comments {
  id         Int      @id @default(autoincrement())
  user_id    Int
  product_id Int
  text       String @db.Text
  created_at DateTime @default(now()) @db.DateTime(0)
  updated_at DateTime @default(now()) @db.DateTime(0)
  rating     Int?     @default(5)
  order_id   Int?
  status     Int      @default(1)

  /// Una reseña por usuario+producto (verificado sin duplicados antes de
  /// agregarlo): cierra la carrera de dos envíos simultáneos y habilita upsert.
  @@unique([user_id, product_id], map: "comments_user_product_key")
  @@index([product_id, status], map: "comments_product_status_idx")
}

model conversations {
  id            Int       @id @default(autoincrement())
  subject       String @db.Text
  sent_user     Int
  recieved_user Int
  message       String @db.Text
  created_at    DateTime? @db.DateTime(0)
  updated_at    DateTime? @db.DateTime(0)
}

model counters {
  id           Int           @id @default(autoincrement())
  type         counters_type @default(referral)
  referral     String?       @db.VarChar(255)
  total_count  Int           @default(0)
  todays_count Int           @default(0)
