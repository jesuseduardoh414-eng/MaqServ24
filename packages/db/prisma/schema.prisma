generator client {
  provider = "prisma-client-js"
  // Motores de consulta que se empaquetan con el cliente. `native` es para
  // desarrollo (Windows); los de Linux hacen falta porque el build se hace
  // fuera y se SUBE ya construido (caso cPanel).
  //
  // NO DEDUZCAS EL TARGET A PARTIR DE LA DISTRIBUCIÓN. El servidor de cPanel es
  // CloudLinux 8.10, así que se puso `rhel-openssl-1.1.x` por puro razonamiento
  // (CloudLinux 8 ≈ RHEL 8 ≈ OpenSSL 1.1.1)... y Prisma pedía
  // **`debian-openssl-1.0.x`**. Su detección no siempre coincide con lo que uno
  // esperaría, y la que manda es la suya.
  //
  // La forma correcta de averiguarlo es leer el error, que trae el nombre exacto:
  //   "could not locate the Query Engine for runtime \"<target>\""
  // Está en el `stderr.log` de la app, y también en el campo `motivo` de /health.
  //
  // El síntoma engaña dos veces: la API arranca perfectamente —el motor se carga
  // en la PRIMERA consulta, no al iniciar— y luego TODO endpoint da 500 mientras
  // /health dice "db: unreachable", que suena a red o a credenciales. Se fueron
  // horas revisando contraseñas que estaban bien.
  //
  // Van los cinco a propósito: pesan ~20 MB cada uno pero cierran la clase entera
  // de fallo, incluido el día que el hosting cambie de versión sin avisar.
  binaryTargets = ["native", "debian-openssl-1.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "mysql"
  url       = env("DATABASE_URL")
}

model about_sections {
  id         BigInt    @id @default(autoincrement())
  type       String @db.Text
  title      String? @db.Text
  content    String @db.Text
  image      String? @db.Text
  order      Int       @default(0)
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)
}

model admin_user_conversations {
  id         Int       @id @default(autoincrement())
  subject    String @db.Text
  user_id    Int
  message    String @db.Text
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)
}

model admin_user_messages {
  id              Int       @id @default(autoincrement())
  conversation_id Int
  message         String @db.Text
  user_id         Int?
  created_at      DateTime? @db.DateTime(0)
  updated_at      DateTime? @db.DateTime(0)
}

model admins {
  id             Int       @id @default(autoincrement())
  name           String @db.Text
  email          String    @unique(map: "admins_email_unique") @db.VarChar(191)
  phone          String @db.Text
  role           String    @default("Administrator") @db.Text
  photo          String? @db.Text
  password       String @db.Text
  status         Int       @default(1) @db.SmallInt
  remember_token String?   @db.VarChar(100)
  created_at     DateTime? @db.DateTime(0)
  updated_at     DateTime? @db.DateTime(0)
  auth_id        String?   @unique @db.Char(36)
}

model advertises {
  id     Int     @id @default(autoincrement())
  type   String @db.Text
  photo  String? @db.Text
