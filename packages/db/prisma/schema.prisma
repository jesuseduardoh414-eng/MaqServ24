model faqs {
  id     Int    @id @default(autoincrement())
  title  String @db.Text
  text   String @db.Text
  status Int    @default(1)
}

/// Preguntas de producto (tipo MercadoLibre): el cliente pregunta, el admin responde.
model product_questions {
  id          Int       @id @default(autoincrement())
  product_id  Int
  user_id     Int
  question    String @db.Text
  answer      String? @db.Text
  status      Int       @default(1)
  created_at  DateTime  @default(now()) @db.DateTime(0)
  answered_at DateTime? @db.DateTime(0)
  updated_at  DateTime  @default(now()) @db.DateTime(0)
  featured    Int       @default(0)

  @@index([product_id, status], map: "product_questions_product_status_idx")
  @@index([featured, status], map: "product_questions_featured_status_idx")
}

model favorite_sellers {
  id        Int @id @default(autoincrement())
