# Copia este archivo a .env (nunca versionar .env — lección del proyecto anterior)
#
# El provider YA ES POSTGRESQL (Supabase). El ejemplo viejo de MariaDB/XAMPP
# confundía a quien montara el entorno: esa BD solo queda como fuente histórica
# de la migración (MYSQL_SOURCE_URL, opcional).
#
# OJO CON EL PUERTO (medido, vale 4-6x en velocidad):
#   :5432 = pooler en modo SESIÓN → 1 viaje por consulta. Lo correcto para la
#           API (proceso Node persistente en Render).
#   :6543 = pooler en modo TRANSACCIÓN (+ ?pgbouncer=true) → 4 viajes por
#           consulta. Solo para serverless.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?connection_limit=10&pool_timeout=20"

# Migraciones/introspección (prisma db push, db pull). Sin pool.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase (Auth + Storage) — la API los lee de aquí en local.
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_ANON_KEY="<anon key>"
SUPABASE_SERVICE_KEY="<service_role key — SECRETO, bypassa RLS>"

# Solo para re-correr la migración de datos MariaDB→Supabase (opcional).
# MYSQL_SOURCE_URL="mysql://root:@localhost:3306/maqserv_dev"
